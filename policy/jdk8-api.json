{
  "$comment": "JDK 9+ 构造清单（单一事实源）。since = 该构造从哪个版本开始可用，供多版本扩展时按「业务仓声明的 Java 版本」动态判定（见 docs/adr/0005-multi-version-rules.md）。当前 J8-MOD-01 仍然按「命中即违规」处理（J8 仓不需要 since）；guard / rule 两个开关的含义不变。",
  "version": 2,
  "entries": [
    {
      "id": "stream-toList",
      "pattern": "(?<!Collectors)\\.toList\\(\\)",
      "since": 16,
      "hint": "Stream#toList 是 Java 16+，J8 用 Collectors.toList()",
      "guard": true,
      "rule": true
    },
    {
      "id": "string-isBlank",
      "pattern": "(?<!StringUtils)\\.isBlank\\(\\)",
      "since": 11,
      "hint": "String#isBlank 是 Java 11+，J8 用 StringUtils.isBlank",
      "guard": true,
      "rule": true
    },
    {
      "id": "string-strip",
      "pattern": "(?<!StringUtils)\\.strip\\(\\)",
      "since": 11,
      "hint": "String#strip 是 Java 11+，J8 用 trim",
      "guard": true,
      "rule": true
    },
    {
      "id": "string-lines",
      "pattern": "\\.lines\\(\\)",
      "hint": "String#lines 是 Java 11+",
      "guard": true,
      "rule": true,
      "since": 11
    },
    {
      "id": "string-repeat",
      "pattern": "\\.repeat\\(\\s*\\d+\\s*\\)",
      "since": 11,
      "hint": "String#repeat 是 Java 11+",
      "guard": true,
      "rule": true
    },
    {
      "id": "transfer-to",
      "pattern": "\\.transferTo\\(",
      "since": 9,
      "hint": "InputStream#transferTo 是 Java 9+，J8 用 IOUtils.copy",
      "guard": true,
      "rule": true
    },
    {
      "id": "list-of",
      "pattern": "List\\.of\\(",
      "since": 9,
      "hint": "List.of 是 Java 9+，J8 用 Arrays.asList",
      "guard": true,
      "rule": true
    },
    {
      "id": "map-of",
      "pattern": "Map\\.of\\(",
      "since": 9,
      "hint": "Map.of 是 Java 9+，J8 用 Collections.unmodifiableMap",
      "guard": true,
      "rule": true
    },
    {
      "id": "set-of",
      "pattern": "Set\\.of\\(",
      "since": 9,
      "hint": "Set.of 是 Java 9+",
      "guard": true,
      "rule": true
    },
    {
      "id": "list-copyOf",
      "pattern": "List\\.copyOf\\(",
      "since": 10,
      "hint": "List.copyOf 是 Java 10+",
      "guard": true,
      "rule": true
    },
    {
      "id": "map-entry",
      "pattern": "Map\\.entry\\(",
      "since": 9,
      "hint": "Map.entry 是 Java 9+",
      "guard": true,
      "rule": true
    },
    {
      "id": "files-readString",
      "pattern": "Files\\.readString\\(",
      "since": 11,
      "hint": "Files#readString 是 Java 11+",
      "guard": true,
      "rule": true
    },
    {
      "id": "files-writeString",
      "pattern": "Files\\.writeString\\(",
      "since": 11,
      "hint": "Files#writeString 是 Java 11+",
      "guard": true,
      "rule": true
    },
    {
      "id": "files-mismatch",
      "pattern": "Files\\.mismatch\\(",
      "since": 12,
      "hint": "Files#mismatch 是 Java 12+",
      "guard": true,
      "rule": true
    },
    {
      "id": "var",
      "pattern": "\\bvar\\s+\\w+\\s*=[^=]",
      "since": 10,
      "hint": "var 是 Java 10+，J8 用显式类型",
      "guard": true,
      "rule": true
    },
    {
      "id": "record",
      "pattern": "\\brecord\\s+[A-Z]\\w*\\s*\\(",
      "since": 16,
      "hint": "record 是 Java 16+，J8 用 final 类 + getter",
      "guard": true,
      "rule": true
    },
    {
      "id": "sealed",
      "pattern": "\\bsealed\\s+(class|interface)",
      "since": 17,
      "hint": "sealed 是 Java 17+",
      "guard": true,
      "rule": true
    },
    {
      "id": "string-formatted",
      "pattern": "\\.formatted\\(",
      "since": 15,
      "hint": "String#formatted 是 Java 15+，J8 用 String.format",
      "guard": true,
      "rule": true
    },
    {
      "id": "optional-orElseThrow-noarg",
      "pattern": "\\.orElseThrow\\(\\s*\\)",
      "since": 10,
      "hint": "Optional#orElseThrow() 无参版是 Java 10+",
      "guard": true,
      "rule": true
    },
    {
      "id": "objects-requireNonNullElse",
      "pattern": "Objects\\.requireNonNullElse\\(",
      "since": 9,
      "hint": "Objects#requireNonNullElse 是 Java 9+",
      "guard": true,
      "rule": true
    },
    {
      "id": "objects-requireNonNullElseGet",
      "pattern": "Objects\\.requireNonNullElseGet\\(",
      "since": 9,
      "hint": "Objects#requireNonNullElseGet 是 Java 9+",
      "guard": true,
      "rule": true
    },
    {
      "id": "collectors-toUnmodifiable",
      "pattern": "Collectors\\.toUnmodifiable\\w+",
      "since": 10,
      "hint": "Collectors#toUnmodifiable* 是 Java 10+",
      "guard": true,
      "rule": true
    },
    {
      "id": "collectors-teeing",
      "pattern": "Collectors\\.teeing\\(",
      "since": 12,
      "hint": "Collectors#teeing 是 Java 12+",
      "guard": true,
      "rule": true
    },
    {
      "id": "instanceof-pattern",
      "pattern": "instanceof\\s+[A-Z]\\w*\\s+[a-z]\\w*\\b",
      "since": 16,
      "hint": "instanceof 模式匹配是 Java 16+",
      "guard": true,
      "rule": true
    },
    {
      "id": "lambda-var",
      "pattern": "\\(\\s*var\\s+\\w+\\s*\\)\\s*->",
      "since": 11,
      "hint": "lambda 形参写 var 是 Java 11+",
      "guard": true,
      "rule": true
    }
  ]
}
