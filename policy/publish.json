{
  "$comment": "发布前脱敏检查的规则表。ds publish-check 用它扫待公开的仓；本文件自身与 allowPaths 不计入。新增内部标识时在这里加一行，不要改代码。historyAllow 是「历史里已知且接受」的枚举（带理由），由 --history 使用。",
  "version": 2,
  "forbidden": [
    {
      "id": "private-ip",
      "pattern": "\\b(?:10\\.\\d{1,3}|192\\.168|172\\.(?:1[6-9]|2\\d|3[01]))\\.\\d{1,3}\\.\\d{1,3}\\b",
      "why": "内网 IP"
    },
    {
      "id": "aws-key",
      "pattern": "AKIA[0-9A-Z]{16}",
      "why": "AWS Access Key"
    },
    {
      "id": "stripe-key",
      "pattern": "sk_live_[A-Za-z0-9]{8,}",
      "why": "支付平台生产密钥"
    },
    {
      "id": "private-key",
      "pattern": "-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----",
      "why": "私钥"
    },
    {
      "id": "internal-repo",
      "pattern": "cloud-integration",
      "why": "内部仓库名"
    },
    {
      "id": "internal-field",
      "pattern": "\\bwellName\\b",
      "why": "业务字段名（产品特化）"
    },
    {
      "id": "internal-user",
      "pattern": "\\b(?:yangR|yxsd)\\b",
      "why": "内部账号名"
    },
    {
      "id": "internal-domain",
      "pattern": "yxsd\\.com\\.cn",
      "why": "内部域名"
    },
    {
      "id": "local-abs-path",
      "pattern": "[A-Za-z]:[\\\\/]{1,2}(?:work|Users|home|root)[\\\\/]\\S*",
      "why": "本机绝对路径（泄漏工作区布局与本机用户名）"
    },
    {
      "id": "workspace-name",
      "pattern": "Alibaba_codeup",
      "why": "内部工作区目录名（不应出现在公开仓）"
    },
    {
      "id": "legacy-package-name",
      "pattern": "dev-standards",
      "why": "另一套同名规范包的名字（提它会引出「那包在哪、什么关系」的追问）"
    }
  ],
  "allowPaths": [
    "policy/publish.json",
    "docs/publish-checklist.md",
    "docs/provenance.md",
    "evals/"
  ],
  "historyAllow": [
    {
      "id": "legacy-package-name",
      "path": "CHANGELOG.md",
      "reason": "0.16.x~0.17.x 的决策记录：先补「迁入」一节、后撤销；CHANGELOG 是历史，不重写。新条目已不再点名"
    },
    {
      "id": "legacy-package-name",
      "path": "docs/**",
      "reason": "同一套包的对比与冲突说明曾写在 docs 里，0.16.1 起改为中性表述；历史不重写"
    },
    {
      "id": "legacy-package-name",
      "path": "README.md",
      "reason": "同上：README 的「与某仓的关系」一节已改为「与同名 skill 包共存」"
    },
    {
      "id": "legacy-package-name",
      "path": "cli/**",
      "reason": "同上：doctor/build 的提示语已中性化，历史保留原话"
    },
    {
      "id": "legacy-package-name",
      "path": "rules/**",
      "reason": "同上（若曾出现在规则正文的对比说明里）"
    },
    {
      "id": "internal-repo",
      "path": "CHANGELOG.md",
      "reason": "真实仓验证记录（命中数 / 豁免数），是「规则真在业务仓跑过」的证据，不点名就没法复核"
    },
    {
      "id": "stripe-key",
      "path": "rules/**",
      "reason": "规则示例里的**假**凭证，用来演示 J8-SPR-15；后来统一改成文档保留地址与占位值"
    },
    {
      "id": "private-ip",
      "path": "rules/**",
      "reason": "同上：示例曾用 10.0.3.7，后来改成文档保留网段 192.0.2.10"
    }
  ]
}
